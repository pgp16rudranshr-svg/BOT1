# --- RECIPIENT INFORMATION ---
RECIPIENT_NAME="Rudransh Rastogi"
RECIPIENT_EMAIL="your_email@example.com"
AFFILIATION="IIM Rohtak (Finance & Tech)"

# --- AI SYNTHESIS (Optional but Recommended) ---
# Get a free Google Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Or OpenAI API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# --- EMAIL DELIVERY (GMAIL SMTP) ---
# For Gmail:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Paste your Gmail and the 16-character App Password below:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your_gmail_address@gmail.com"
SMTP_PASSWORD="your_16_char_app_password"
EMAIL_FROM="your_gmail_address@gmail.com"

# --- SCHEDULE SETTINGS ---
# Daily delivery time (24-hour format HH:MM). Default is 10:00 AM.
DAILY_DELIVERY_TIME="10:00"
TIMEZONE="Asia/Kolkata"
